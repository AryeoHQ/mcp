{
    "name": "aryeo/mcp",
    "description": "Customizations and dynamic primitive registration for laravel/mcp",
    "type": "library",
    "require": {
        "php": "^8.4",
        "aryeo/tooling-laravel": "0.0.41",
        "laravel/framework": "^12.36 || ^13",
        "laravel/mcp": "^1.1",
        "nikic/php-parser": "^5.7",
        "phpstan/phpstan": "^2.1",
        "symfony/console": "^7.3 || ^8.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.14",
        "orchestra/testbench": "^10.6 || ^11",
        "orchestra/testbench-core": "^10.7 || ^11",
        "phpunit/phpunit": "^12.5 || ^13"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/tooling-laravel.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Support\\Mcp\\": "src/Support/Mcp/",
            "Tooling\\Mcp\\": "src/Tooling/Mcp/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true
        },
        "preferred-install": {
            "laravel/pint": "source"
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Mcp\\Providers\\Provider"
            ]
        },
        "tooling": {
            "phpstan": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                },
                "rules": "tooling/phpstan/rules.neon"
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests"
                    ]
                }
            },
            "rector": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                },
                "rules": "tooling/rector/rules.php"
            }
        }
    }
}
